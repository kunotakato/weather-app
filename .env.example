# このファイルをコピーして .env.local を作り、値を入れてください（.env.local は Git に入りません）
#   cp .env.example .env.local

# 必須: OpenWeatherMap の API キー https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=

# 任意: Yahoo! JAPAN の Client ID（入れると「この先1時間の雨」を表示）
# https://e.developer.yahoo.co.jp/register
YAHOO_CLIENT_ID=
